generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" //"cockroachdb"
}

// enums 
enum Language {
  RU
  EN
}

enum LinkKind {
  GITHUB
  LINKEDIN
  TELEGRAM
  EMAIL
  WEBSITE
}

enum ReviewType {
  CLIENT
  EMPLOYER
}

enum SkillCategory {
  LANGUAGE
  BACKEND
  FRONTEND
  DATABASE
  INFRA
  TOOL
}

// models

model Profile {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique

  links               ProfileLink[]
  skills              Skill[]
  experience          Experience[]
  projects            Project[]
  profileTranslations ProfileTranslation[]
}

model ProfileTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String   @db.Uuid
  language    Language
  name        String
  headline    String
  description String
  location    String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, language])
}

model ProfileLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @db.Uuid
  kind      LinkKind
  label     String
  url       String
  order     Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String        @db.Uuid
  name      String
  category  SkillCategory
  level     Int           @default(3)
  order     Int           @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}

model Experience {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String    @db.Uuid
  company   String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  profile                Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements           Achievement[]
  experienceTranslations ExperienceTranslation[]

  @@index([profileId, startDate])
  @@map("experiences")
}

model ExperienceTranslation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experienceId String   @db.Uuid
  language     Language
  position     String
  description  String?

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, language])
}

model Achievement {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experienceId String @db.Uuid
  order        Int    @default(0)

  experience              Experience               @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  achievementTranslations AchievementTranslation[]

  @@index([experienceId])
  @@map("achievements")
}

model AchievementTranslation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  achievementId String   @db.Uuid
  language      Language
  text          String

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([achievementId, language])
}

model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @db.Uuid
  repoUrl   String?
  liveUrl   String?
  stack     String[]
  order     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  profile             Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  images              ProjectImage[]
  reviewTokens        ReviewToken[]
  reviews             Review[]
  projectTranslations ProjectTranslation[]

  @@index([profileId])
}

model ProjectTranslation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @db.Uuid
  language    Language
  name        String
  description String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, language])
}

model ReviewToken {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      ReviewType
  projectId String?    @db.Uuid
  isUsed    Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Review {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       ReviewType
  authorName String
  company    String?
  avatarUrl  String?
  rating     Int?
  projectId  String?    @db.Uuid
  createdAt  DateTime   @default(now())

  project            Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewTranslations ReviewTranslation[]
}

model ReviewTranslation {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId String   @db.Uuid
  language Language
  position String?
  text     String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, language])
}

model ProjectImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String  @db.Uuid
  url       String
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}
