generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" //"cockroachdb"
}

// enums 
enum LinkKind {
  GITHUB
  LINKEDIN
  TELEGRAM
  EMAIL
  WEBSITE
}

enum ReviewType {
  CLIENT
  EMPLOYER
}

enum SkillCategory {
  LANGUAGE
  BACKEND
  FRONTEND
  DATABASE
  INFRA
  TOOL
}

// models
model Profile {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  headline    String
  description String
  location    String?
  email       String  @unique

  links      ProfileLink[]
  skills     Skill[]
  experience Experience[]
  projects   Project[]
}

model ProfileLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @db.Uuid
  kind      LinkKind
  label     String
  url       String
  order     Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String        @db.Uuid
  name      String
  category  SkillCategory
  level     Int           @default(3)
  order     Int           @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}

model Experience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @db.Uuid
  company     String
  position    String
  description String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@index([profileId, startDate])
  @@map("experiences")
}

model Achievement {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experienceId String @db.Uuid
  text         String
  order        Int    @default(0)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@map("achievements")
}

model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String   @db.Uuid
  name        String
  description String
  repoUrl     String?
  liveUrl     String?
  stack       String[]
  order       Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  images       ProjectImage[]
  reviewTokens ReviewToken[]
  reviews      Review[]

  @@unique([profileId, name])
  @@index([profileId])
}

model ProjectImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String  @db.Uuid
  url       String
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

model ReviewToken {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      ReviewType
  projectId String?    @db.Uuid
  isUsed    Boolean    @default(false)
  expiresAt DateTime   @default(now())
  createAt  DateTime   @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Review {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       ReviewType
  authorName String
  company    String?
  position   String?
  avatarUrl  String?
  text       String
  rating     Int?
  projectId  String?     @db.Uuid
  createdAt  DateTime   @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
