# react-app/Dockerfile

# 1. Builder
FROM dockerhub.timeweb.cloud/library/node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Vite подставляет переменные на этапе сборки, поэтому это ARG, а не ENV рантайма.
# Пустая строка = запросы идут на свой же origin, а nginx проксирует их на бэкенд.
ARG VITE_BACKEND_URL=""
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL

RUN npm run build

# 2. Runner
FROM dockerhub.timeweb.cloud/library/nginx:alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
